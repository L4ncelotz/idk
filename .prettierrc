{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.json", "options": { "parser": "json" } },
    { "files": "*.md", "options": { "parser": "markdown" } },
    { "files": "*.yaml", "options": { "parser": "yaml" } },
    { "files": "*.yml", "options": { "parser": "yaml" } }
  ]
}
