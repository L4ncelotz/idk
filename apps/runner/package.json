{
  "name": "@rupture/runner",
  "version": "0.1.0",
  "private": true,
  "description": "Rupture internal runner foundation.",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @rupture/config --filter @rupture/contracts build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rupture/config": "workspace:*",
    "@rupture/contracts": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
